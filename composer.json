{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "emaia/laravel-hotwire-starter",
    "type": "project",
    "description": "A Laravel starter kit with Hotwire and Docker.",
    "keywords": [
        "laravel",
        "hotwire"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "emaia/laravel-hotwire": "^0.91.0",
        "laravel/fortify": "^1.37",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.12",
        "laravel/boost": "^2.2",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.32.3",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "bun install --frozen-lockfile --ignore-scripts",
            "bun run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "bun run dev"
        ],
        "boost:sync": "@php artisan boost:update --no-discover --no-interaction",
        "analyze": "./vendor/bin/phpstan analyse",
        "format": [
            "./vendor/bin/pint",
            "bun run format"
        ],
        "lint:check": "./vendor/bin/pint --test",
        "test:ci": "./vendor/bin/pest --ci --compact",
        "check": [
            "composer validate --no-check-publish",
            "@lint:check",
            "@analyze",
            "@php artisan hotwire:check --no-interaction",
            "@test:ci",
            "bun run check"
        ],
        "prepare": [
            "@analyze",
            "@format"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@boost:sync"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
